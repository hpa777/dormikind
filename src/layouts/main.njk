        <div id="scroll-prompt" class="invisible fixed bottom-20 left-1/2 grid aspect-square w-[3.13rem] place-content-center rounded-full border-2 border-white opacity-0">
            <svg style="width:1.87rem;height: 1.25rem;" width="30" height="20" viewBox="0 0 30 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1.00002L15.098 17.9997L29 1.00002" stroke="white" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>
        <script type="module" src="/src/js/main.js"></script>
        <script>
            window.scrollTo(0, 0)
            history.scrollRestoration = 'manual'
            //history.scrollRestoration = 'auto'
            document.addEventListener('DOMContentLoaded', () => {
                const prompt = document.getElementById('scroll-prompt')
                let scrollTimeout

                // Функция проверки: доскроллил ли пользователь до самого конца
                function isPageEnd() {
                    // Высота прокрученной части + высота окна >= полной высоте документа
                    return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5
                }

                // Функция, которая показывает плашку
                function showPrompt() {
                    if (!isPageEnd()) {
                        prompt.classList.add('show')
                    }
                }

                // Функция сброса таймера при активности
                function resetTimer() {
                    // Сразу прячем плашку при любом скролле или действии
                    prompt.classList.remove('show')

                    // Очищаем старый таймер
                    clearTimeout(scrollTimeout)

                    // Запускаем новый таймер на 30 секунд (30000 миллисекунд)
                    scrollTimeout = setTimeout(showPrompt, 3000)
                }

                // Отслеживаем скролл и движения пользователя
                window.addEventListener('scroll', resetTimer)
                window.addEventListener('touchstart', resetTimer) // Для мобильных

                // Запускаем таймер при первой загрузке страницы
                resetTimer()
            })
        </script>
