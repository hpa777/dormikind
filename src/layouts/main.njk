                    <img scroll-zoom data-move data-trigger=".night-bg" data-start="top top" data-scale="0" class="absolute top-[52vh] left-[92.6%] hidden scale-[0.2] lg:block" src="/images/star.png" alt="" />
                    <img scroll-zoom data-move data-trigger=".night-bg" data-start="top top" data-scale="0" class="absolute top-[59.2vh] left-[84.4%] hidden scale-[0.15] lg:block" src="/images/star.png" alt="" />
                    <img scroll-zoom data-move data-trigger=".night-bg" data-start="top top" data-scale="0" class="absolute top-[62.8vh] left-[87.8%] hidden scale-[0.5] lg:block" src="/images/star.png" alt="" />
                </div>
                <div id="clouds-back" class="absolute bottom-0 h-0 w-full">
