                            <img
                                data-move="to"
                                data-opacity="1"
                                data-y="-150vh"
                                data-rotate="48"
                                data-trigger=".scrubMarker1"
                                data-start="top top"
                                data-end="bottom -250%"
                                class="w-55 max-w-none -rotate-10 blur-sm md:w-84 xl:w-127"
                                src="/images/star-f-1.png"
                                alt="" />
                        </div>
                    </div>
                    <!--/Stars-->
                    <!--Scene 1 text-->
                    <div class="absolute inset-0" data-trigger=".scene-2" data-endtrigger=".scrubMarker1" data-start="top center" data-move="to">
                        <div
                            data-move="to"
                            data-trigger="no"
                            data-opacity="1"
                            data-duration="3"
                            data-delay="0.5"
                            class="mls:h-full mls:py-0 mls:flex mls:flex-col mls:justify-center container pt-[5.7rem] opacity-0 md:pt-38 xl:pt-40">
                            <p class="mls:text-6xl text-[2.56rem] leading-[1.1] font-extrabold uppercase md:text-[6.63rem] xl:text-[11.6rem]">Сказочный сон</p>
                            <p class="text-[1.31rem] uppercase md:text-[1.88rem] xl:text-[2.81rem]">для активности днём</p>
                            <p class="tex-[0.94rem] max-w-84 md:text-xl xl:mt-8 xl:max-w-160 xl:text-3xl">Лекарственный препарат при беспокойстве и нарушениях сна у детей до 6 лет</p>
                            <!--div class="mt-[1.2rem] flex h-[1.81rem] text-sm md:h-[2.19rem] md:text-[0.94rem] xl:mt-14 xl:h-[3.44rem] xl:text-xl">
                                <a href="" class="group text-my-violet flex transition-colors hover:text-white">
                                    <span class="grid aspect-square h-full place-content-center rounded-full border border-white bg-white px-2 transition-all group-hover:rotate-90 group-hover:bg-transparent">
                                        <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="max-w-full">
                                            <path
                                                d="M0.420103 16.4589C-0.154863 17.0553 -0.137479 18.0049 0.458932 18.5799C1.05534 19.1549 2.00493 19.1375 2.5799 18.5411L1.5 17.5L0.420103 16.4589ZM18.4245 1.47254C18.4093 0.644256 17.7255 -0.0149122 16.8973 0.000251293L3.39951 0.247355C2.57122 0.262518 1.91206 0.946271 1.92722 1.77456C1.94238 2.60285 2.62614 3.26202 3.45442 3.24685L15.4524 3.0272L15.6721 15.0252C15.6872 15.8535 16.371 16.5127 17.1993 16.4975C18.0276 16.4823 18.6867 15.7986 18.6716 14.9703L18.4245 1.47254ZM1.5 17.5L2.5799 18.5411L18.0046 2.54107L16.9247 1.5L15.8448 0.458932L0.420103 16.4589L1.5 17.5Z"
                                                fill="currentColor" />
                                        </svg>
                                    </span>
                                    <span class="grid h-full place-content-center rounded-full border border-white bg-white px-3.5 whitespace-nowrap transition-colors group-hover:bg-transparent md:px-7 xl:px-[2.4rem]"
                                        >Купить сейчас</span
                                    >
                                </a>
                                <a href="" class="hover:text-my-violet ml-4 grid h-full place-content-center rounded-full border border-white px-3.5 transition-colors hover:bg-white md:px-7 xl:px-[2.4rem]">Инструкция</a>
                            </div-->
                        </div>
                    </div>
                    <!--/Scene 1 text-->
                </div>
            </div>
            <!--/Boy-->
            <div class="scrubMarker1 absolute top-[177vh] left-0 z-10 h-1 w-full"></div>
            <div class="scrubMarker2 absolute top-[280vh] left-0 z-10 h-1 w-full"></div>
            <!--Scene7-->
