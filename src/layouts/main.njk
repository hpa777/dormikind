                        </picture>
                    </div>
                    <!--/Clouds Front-->
                    <!--Stars-->
                    <div class="absolute inset-0 grid grid-cols-16 grid-rows-40">
                        <div scroll-zoom class="col-start-9 row-start-8 grid place-content-center md:col-start-6 md:row-start-10 xl:col-start-10 xl:row-start-5">
                            <img
                                data-move="to"
                                data-opacity="1"
                                data-y="-150vh"
                                data-rotate="48"
                                data-trigger=".scrubMarker1"
                                data-start="top top"
                                data-end="bottom -250%"
                                class="w-26 max-w-none -rotate-10 md:w-56 xl:w-86"
                                src="/images/star-f-1.png"
                                alt="" />
                        </div>
                        <div scroll-zoom class="col-start-14 row-start-11 grid place-content-center md:col-start-16 md:row-start-7 xl:col-start-16 xl:row-start-1">
                            <img
                                data-move="to"
                                data-opacity="1"
                                data-y="-150vh"
                                data-rotate="48"
                                data-trigger=".scrubMarker1"
                                data-start="top top"
                                data-end="bottom -250%"
                                class="w-44 max-w-none -rotate-10 blur-[2px] md:ml-16 md:w-70 xl:w-102"
