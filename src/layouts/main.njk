                    <img scroll-zoom data-move data-trigger=".night-bg" data-start="top top" data-scale="0" class="absolute top-[27.1vh] left-[91%] hidden scale-[0.2] lg:block" src="/images/star.png" alt="" />
                    <img scroll-zoom data-move data-trigger=".night-bg" data-start="top top" data-scale="0" class="absolute top-[42.2vh] left-[92.1%] hidden scale-[0.4] lg:block" src="/images/star.png" alt="" />
