<!doctype html>
<html lang="ru" class="page">
    {% include 'components/head.njk' %}
    <body class="font-nunito font-normal text-white">
        <!-- Header-->
        <header class="fixed top-0 left-0 z-53 w-full">
            <div class="mls:pt-6 mls:flex-row container flex items-center justify-between pt-5 md:flex-row-reverse md:pt-11 xl:hidden">{% include 'components/header_mob.njk' %}</div>
            <div>{% include 'components/main_menu.njk' %}</div>
        </header>

        <!-- /Header-->
        <main class="relative overflow-clip">
            <!--Boy-->
            <div class="scene-1 sticky top-0 min-h-screen">
                <div class="sticky top-0 h-screen">
                    <picture>
                        <source srcset="/images/first-part-bg-lg.png" media="(min-width: 1024px)" />
                        <source srcset="/images/first-part-bg-md.png" media="(min-width: 768px)" />
                        <img class="h-full w-full object-cover" src="/images/first-part-bg.png" alt="" />
                    </picture>
                    <!--Gradient bg-->
                    <div
                        class="absolute inset-0 bg-[linear-gradient(180deg,rgba(17,24,42,0)_0%,rgba(17,24,42,0.66)_41.49%,#11182a_93.7%)] opacity-0"
                        data-move="to"
                        data-trigger=".scene-1"
                        data-start="center top"
                        data-opacity="1"></div>
                    <!--/Gradient bg-->
                    <!--Clouds Back-->
                    <div class="mls:hidden absolute right-0 bottom-0 w-full">
                        <picture>
                            <source srcset="/images/cloud-back-lg.png" media="(min-width: 1280px)" />
                            <source srcset="/images/cloud-back-md.png" media="(min-width: 667px)" />
                            <img src="/images/cloud-back.png" class="ml-auto w-full md:w-auto" alt="" data-move="to" data-y="350" data-start="center top" data-end="+=300%" />
                        </picture>
                    </div>
                    <!--/Clouds Back-->
                    <!--Pack-->
                    <div data-move="to" data-scale="0.9" data-opacity="0" data-trigger=".scene-2" data-start="bottom top">
                        <canvas
                            id="my-canvas"
                            style="backface-visibility: hidden; transform: translateZ(0)"
                            class="ret:-bottom-24 mls:h-screen absolute right-0 bottom-0 aspect-[2] h-[80vh] opacity-0 md:h-[95vh] lg:-right-12 lg:-bottom-4 xl:bottom-0 xl:h-screen"></canvas>
                    </div>
                    <!--/Pack-->
                    <!--Clouds Front-->
                    <div class="absolute right-0 bottom-0 w-full">
                        <picture>
                            <source srcset="/images/cloud-front-lg.png" media="(min-width: 1280px)" />
                            <source media="((max-width: 932px) and (max-height:430px) and (orientation: landscape))" srcset="/images/cloud-front-mls.png" />
                            <source srcset="/images/cloud-back-md.png" media="(min-width: 667px)" />
